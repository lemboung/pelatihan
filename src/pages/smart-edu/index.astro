---
import TrainingLayout from '../../layouts/TrainingLayout.astro';
import Slide from '../../components/Slide.astro';
import SlideHeader from '../../components/SlideHeader.astro';
import Progress from '../../components/Progress.astro';
import Tag from '../../components/Tag.astro';
---

<TrainingLayout
  title="SmartEdu Pesantren | Ekosistem Pembinaan Terhubung"
  description="Presentasi ekosistem SmartEdu untuk pesantren: santri fokus, orang tua tenang, dan tim sekolah bertumbuh bersama."
>
  <Slide id="cover" bg="dark" class="smart-cover">
    <div class="cover-layout">
      <div class="cover-copy">
        <Tag label="PRESENTASI EKOSISTEM PESANTREN" color="success" />
        <p class="eyebrow">SMARTEDU PESANTREN</p>
        <h1>Santri lebih fokus.<br /><span>Keluarga tetap dekat.</span></h1>
        <p class="lead">Satu ekosistem yang membantu pesantren membina dengan lebih utuh, tanpa membawa smartphone pribadi ke dalam keseharian santri.</p>
        <div class="cover-points">
          <span>Kepercayaan</span><span>Pembinaan</span><span>Kemandirian</span>
        </div>
      </div>
      <div class="cover-visual" aria-label="Gambaran SmartEdu Pesantren">
        <img src="/images/smart-edu/pesantren-hero.jpg" alt="Suasana ibadah umat Muslim" />
        <div class="phone-preview">
          <div class="phone-preview__top"><span>SmartEdu</span><span>08.15</span></div>
          <div class="phone-preview__greeting">Assalamu'alaikum,<br /><strong>Bu Nisa</strong></div>
          <div class="phone-preview__card">
            <small>HARI INI</small>
            <strong>Ananda hadir, belajar, dan beribadah dengan baik.</strong>
          </div>
          <div class="phone-preview__rows">
            <span>Akademik <b>Terpantau</b></span>
            <span>Halaqah <b>Setoran 3 ayat</b></span>
            <span>Kesehatan <b>Baik</b></span>
          </div>
          <div class="phone-preview__nav"><b>Beranda</b><span>Aktivitas</span><span>Pesan</span></div>
        </div>
      </div>
    </div>
  </Slide>

  <Slide id="why-now" class="smart-slide">
    <SlideHeader badge="TITIK AWAL" title="Ketenangan di pondok tidak perlu berarti jarak di rumah." subtitle="SmartEdu menjaga batas yang sehat: santri hidup hadir di pesantren, orang tua tetap mendapat kabar yang bermakna." />
    <div class="statement-grid">
      <article><span class="statement-number">01</span><h3>Santri hadir sepenuhnya</h3><p>Tidak ada smartphone pribadi yang memecah fokus belajar, ibadah, pertemanan, dan tidur.</p></article>
      <article><span class="statement-number">02</span><h3>Orang tua tidak menebak</h3><p>Ringkasan yang terverifikasi memberi rasa tenang tanpa mengubah pengasuhan menjadi pengawasan berlebihan.</p></article>
      <article><span class="statement-number">03</span><h3>Tim lebih leluasa membina</h3><p>Rutinitas administrasi menjadi lebih rapi sehingga waktu pengasuh kembali ke percakapan yang penting.</p></article>
    </div>
  </Slide>

  <Slide id="ecosystem" bg="light" class="smart-slide">
    <SlideHeader badge="SATU EKOSISTEM" title="Setiap pemangku kepentingan mendapat ruang yang tepat." subtitle="Bukan satu aplikasi yang memaksa semua orang bekerja sama persis; setiap peran melihat dan melakukan yang memang dibutuhkan." />
    <div class="ecosystem-grid">
      <article><strong>Santri</strong><p>Kartu NFC, jadwal, target pribadi, dan bantuan yang hadir tanpa layar pribadi.</p></article>
      <article><strong>Orang Tua</strong><p>Kabar harian, komunikasi terarah, izin, pembayaran, dan perkembangan anak.</p></article>
      <article><strong>Pengasuh & Guru</strong><p>Catatan pembinaan, kehadiran, pencapaian, tindak lanjut, dan koordinasi.</p></article>
      <article><strong>Pimpinan</strong><p>Gambaran kesehatan operasional dan mutu pembinaan untuk keputusan yang lebih cepat.</p></article>
    </div>
    <div class="ecosystem-line" aria-hidden="true"><span></span><b>SMARTEDU</b><span></span></div>
  </Slide>

  <Slide id="cashless" class="smart-slide">
    <SlideHeader badge="TRANSAKSI AMAN" title="Belanja mandiri, tetap dalam perlindungan." subtitle="Kartu NFC membantu santri belajar mengelola uang. Verifikasi wajah menambahkan lapisan kepercayaan pada momen yang paling penting." />
    <div class="flow-wrap">
      <div class="flow-card"><span>1</span><strong>Tap kartu</strong><p>Santri cukup membawa satu kartu untuk kebutuhan harian.</p></div>
      <i>→</i>
      <div class="flow-card"><span>2</span><strong>Verifikasi wajah</strong><p>Petugas dan sistem memastikan transaksi dilakukan oleh pemiliknya.</p></div>
      <i>→</i>
      <div class="flow-card"><span>3</span><strong>Catatan langsung</strong><p>Saldo, batas belanja, dan riwayat tercatat untuk orang tua serta sekolah.</p></div>
    </div>
    <p class="quiet-note">Aturan belanja tetap milik pesantren dan keluarga. SmartEdu membantu menjalankannya dengan konsisten.</p>
  </Slide>

  <Slide id="checkout-prototype" bg="light" class="smart-slide">
    <SlideHeader badge="PROTOTIPE 01" title="Pengalaman transaksi yang ringan untuk santri dan petugas." subtitle="Satu alur di kasir: pilih, tap, verifikasi, selesai. Orang tua mendapat catatan yang jelas tanpa perlu memegang uang tunai." />
    <div class="prototype-split">
      <section class="pos-prototype" aria-label="Prototype kasir SmartEdu">
        <div class="prototype-top"><b>Kantin Al-Barokah</b><span>Kasir 03</span></div>
        <div class="pos-body"><div><small>KERANJANG</small><strong>Makan siang santri</strong><span>Rp18.000</span></div><div><small>PEMBAYARAN</small><strong>NFC + verifikasi wajah</strong><span class="status-good">Siap diproses</span></div></div>
        <div class="face-scan"><span class="scan-frame"></span><div><small>VERIFIKASI WAJAH</small><strong>Ahmad Fauzan</strong><p>Kelas 8B · saldo tersedia Rp142.000</p></div><b>✓</b></div>
        <div class="pos-footer"><span>Total</span><strong>Rp18.000</strong><button type="button">Konfirmasi</button></div>
      </section>
      <section class="parent-receipt" aria-label="Notifikasi transaksi untuk orang tua">
        <div class="receipt-notice"><span>SmartEdu</span><time>baru saja</time></div>
        <strong>Transaksi berhasil</strong><p>Ahmad menggunakan kartu NFC di Kantin Al-Barokah.</p><div><span>Jumlah</span><b>Rp18.000</b></div><div><span>Sisa saldo</span><b>Rp124.000</b></div><small>Dalam batas harian keluarga</small>
      </section>
    </div>
  </Slide>

  <Slide id="parent" bg="dark" class="smart-slide parent-slide">
    <SlideHeader badge="ORANG TUA" title="Kabar yang membuat orang tua tenang, bukan cemas." subtitle="Alih-alih rangkaian notifikasi, orang tua menerima ringkasan yang memberi konteks dan kesempatan untuk hadir dengan cara yang tepat." />
    <div class="parent-layout">
      <div class="parent-timeline">
        <div><time>05.00</time><span>Shalat Subuh berjamaah tercatat</span></div>
        <div><time>08.10</time><span>Hadir di kelas Bahasa Arab</span></div>
        <div><time>12.30</time><span>Makan siang sesuai batas harian</span></div>
        <div><time>19.30</time><span>Setoran hafalan selesai</span></div>
      </div>
      <div class="parent-copy"><h3>Komunikasi yang lebih manusiawi</h3><p>Pesan penting, jadwal kunjungan, laporan kesehatan, dan permintaan izin masuk ke satu jalur yang jelas. Pengasuh tidak lagi tenggelam dalam chat yang tercecer.</p><p>Orang tua bisa memberi dukungan dengan lebih paham, bukan sekadar lebih sering bertanya.</p></div>
    </div>
  </Slide>

  <Slide id="parent-prototype" class="smart-slide">
    <SlideHeader badge="PROTOTIPE 02" title="Beranda orang tua yang menenangkan dan siap ditindaklanjuti." subtitle="Ringkasan yang sederhana untuk dilihat sekilas, dengan jalur jelas ketika keluarga perlu menghubungi pesantren." />
    <div class="parent-app-layout">
      <section class="parent-app" aria-label="Prototype aplikasi orang tua SmartEdu">
        <div class="app-status"><span>9.41</span><b>SmartEdu</b><span>•••</span></div>
        <p>Assalamu'alaikum,</p><h3>Ibu Nisa</h3>
        <div class="student-chip"><span>AF</span><div><strong>Ahmad Fauzan</strong><small>Kelas 8B · Asrama Ibnu Sina</small></div><b>⌄</b></div>
        <div class="daily-card"><small>RINGKASAN HARI INI</small><strong>Hari yang terarah, alhamdulillah.</strong><div><span>Hadir kelas</span><b>100%</b><span>Setoran</span><b>3 ayat</b></div></div>
        <div class="app-actions"><button type="button">Aktivitas</button><button type="button">Pesan</button><button type="button">Izin</button><button type="button">Keuangan</button></div>
      </section>
      <div class="parent-side-list"><div><b>Catatan pembina</b><p>Ahmad aktif dalam diskusi Bahasa Arab hari ini.</p><small>Ditulis oleh Ust. Rafi</small></div><div><b>Agenda berikutnya</b><p>Kunjungan wali santri dibuka Sabtu, 10.00-15.00.</p><small>Lihat jadwal kunjungan</small></div><div><b>Perlu perhatian?</b><p>Fitur bantuan menghubungkan keluarga ke pihak yang tepat, bukan bot.</p><small>Hubungi wali asrama</small></div></div>
    </div>
  </Slide>

  <Slide id="growth" bg="light" class="smart-slide">
    <SlideHeader badge="TUMBUH MENYELURUH" title="Kemajuan santri adalah lebih dari nilai rapor." subtitle="SmartEdu menyatukan jejak akademik, kebiasaan ibadah, kemandirian, dan kesejahteraan dalam satu gambaran pembinaan." />
    <div class="growth-grid">
      <article><span class="growth-mark">A</span><h3>Akademik</h3><p>Kehadiran, tugas, hasil belajar, dan dukungan saat santri perlu mengejar ketertinggalan.</p></article>
      <article><span class="growth-mark">I</span><h3>Ibadah & Akhlak</h3><p>Rutinitas, hafalan, halaqah, dan catatan pembinaan yang menghargai proses.</p></article>
      <article><span class="growth-mark">D</span><h3>Diri & Kesehatan</h3><p>Check-in keseharian, catatan klinik, dan jalur dukungan untuk kesejahteraan psikologis.</p></article>
    </div>
  </Slide>

  <Slide id="progress-prototype" class="smart-slide progress-prototype-slide">
    <SlideHeader badge="PROTOTIPE 03" title="Perkembangan yang terlihat, proses yang tetap dihargai." subtitle="Pengasuh dan orang tua dapat melihat kemajuan mingguan tanpa mereduksi perjalanan santri menjadi satu angka." />
    <div class="progress-prototype">
      <div class="progress-profile"><span>AF</span><div><strong>Ahmad Fauzan</strong><small>Ringkasan 7 hari terakhir</small></div><b>Perbarui laporan</b></div>
      <div class="progress-metrics"><div><small>AKADEMIK</small><strong>84</strong><span>Stabil</span></div><div><small>KEHADIRAN</small><strong>100%</strong><span>Lengkap</span></div><div><small>HAFALAN</small><strong>12</strong><span>ayat pekan ini</span></div><div><small>KESEJAHTERAAN</small><strong>Baik</strong><span>Check-in normal</span></div></div>
      <div class="progress-columns"><section><b>Rutinitas pembinaan</b><div class="habit"><span>Shalat jamaah</span><i><em style="width: 96%"></em></i><strong>96%</strong></div><div class="habit"><span>Hadir kelas</span><i><em style="width: 100%"></em></i><strong>100%</strong></div><div class="habit"><span>Setoran hafalan</span><i><em style="width: 72%"></em></i><strong>72%</strong></div></section><section><b>Catatan minggu ini</b><p>Menunjukkan ketekunan dalam halaqah. Perlu didampingi agar lebih percaya diri saat presentasi kelas.</p><small>Catatan dibuat untuk membina, bukan membandingkan.</small></section></div>
    </div>
  </Slide>

  <Slide id="wellbeing" class="smart-slide wellbeing-slide">
    <SlideHeader badge="KESEJAHTERAAN" title="Mendengar lebih awal, mendampingi lebih dekat." subtitle="Sinyal kesejahteraan tidak dipakai untuk memberi label pada santri. Ia membantu wali kamar, guru BK, dan orang tua memilih waktu terbaik untuk hadir." />
    <div class="wellbeing-layout">
      <div class="wellbeing-panel"><span>CATATAN TERARAH</span><strong>Perubahan pola tidur, kehadiran, atau interaksi dapat menjadi alasan untuk bertanya dengan lembut.</strong></div>
      <div class="wellbeing-points"><p><b>Privat dan berbasis peran</b> - informasi sensitif hanya terlihat oleh pihak yang memang perlu membantu.</p><p><b>Ada tindak lanjut manusia</b> - sistem menandai perhatian, pembina menentukan respons.</p><p><b>Berpihak pada pemulihan</b> - fokus pada dukungan, bukan penghukuman.</p></div>
    </div>
  </Slide>

  <Slide id="team" bg="dark" class="smart-slide">
    <SlideHeader badge="UNTUK TIM PESANTREN" title="Administrasi yang lebih rapi, ruang pembinaan yang lebih luas." subtitle="SmartEdu tidak menggantikan ustadz, musyrif, wali kelas, atau guru BK. Sistem menangani keterhubungan data agar manusia bisa lebih hadir." />
    <div class="team-grid">
      <div><strong>Kehadiran & perizinan</strong><span>Lebih cepat direkap, lebih mudah ditindaklanjuti.</span></div>
      <div><strong>Catatan pembinaan</strong><span>Riwayat yang utuh saat tanggung jawab berpindah.</span></div>
      <div><strong>Komunikasi terarah</strong><span>Informasi sampai ke keluarga tanpa rantai pesan yang panjang.</span></div>
      <div><strong>Laporan pimpinan</strong><span>Melihat pola untuk mengambil keputusan, bukan sekadar angka.</span></div>
    </div>
  </Slide>

  <Slide id="staff-prototype" bg="light" class="smart-slide">
    <SlideHeader badge="PROTOTIPE 04" title="Command center untuk tim yang ingin lebih sigap, bukan lebih sibuk." subtitle="Satu tampilan membantu pimpinan dan staf membaca kondisi hari ini, lalu mengarahkan perhatian ke hal yang perlu ditindaklanjuti manusia." />
    <div class="staff-dashboard">
      <div class="dashboard-head"><div><small>SMARTEDU OPERATIONS</small><strong>Selasa, 8 September</strong></div><span>Semua asrama</span></div>
      <div class="dashboard-kpis"><div><span>Hadir pagi</span><b>1.248 <small>/ 1.260</small></b></div><div><span>Izin aktif</span><b>12</b></div><div><span>Transaksi hari ini</span><b>438</b></div><div><span>Tindak lanjut</span><b class="amber">5</b></div></div>
      <div class="dashboard-lower"><section><b>Perlu ditinjau</b><div><span>Asrama Al-Kindi</span><small>3 santri belum check-in pagi</small><button type="button">Lihat</button></div><div><span>Kelas 9A</span><small>2 izin kesehatan belum diperbarui</small><button type="button">Lihat</button></div></section><section><b>Aktivitas terkini</b><p>07.24 · Kehadiran kelas selesai direkap</p><p>07.18 · 4 permintaan izin telah disetujui</p><p>06.55 · Laporan Subuh tersedia untuk wali</p></section></div>
    </div>
  </Slide>

  <Slide id="features" class="smart-slide">
    <SlideHeader badge="FITUR EKOSISTEM" title="Cukup luas untuk menemani kehidupan pesantren sehari-hari." subtitle="Modul dirancang untuk saling menguatkan, sementara pesantren tetap memilih prioritas yang paling relevan." />
    <div class="feature-grid">
      <div><b>Kehadiran & perizinan</b><span>Check-in, izin pulang, kunjungan wali, dan jejak persetujuan.</span></div><div><b>Kantin & koperasi</b><span>NFC, batas pengeluaran, katalog, dan rekap transparan.</span></div><div><b>Asrama & pembinaan</b><span>Wali kamar, kegiatan, catatan tindak lanjut, dan apresiasi.</span></div><div><b>Akademik & halaqah</b><span>Jadwal, tugas, nilai, hafalan, dan target personal.</span></div><div><b>Klinik & kesejahteraan</b><span>Riwayat layanan, catatan sensitif berbasis peran, dan eskalasi.</span></div><div><b>Komunikasi keluarga</b><span>Pengumuman, pesan terarah, pembayaran, dan laporan bermakna.</span></div>
    </div>
  </Slide>

  <Slide id="leadership" bg="dark" class="smart-slide leadership-slide">
    <SlideHeader badge="AMANAH PIMPINAN" title="Teknologi yang memperkuat kepemimpinan pesantren, bukan menggesernya." subtitle="Bagi kiai, pengasuh, dan pemilik lembaga, SmartEdu memberi pandangan yang lebih utuh tanpa mengubah pesantren menjadi mesin administrasi." />
    <div class="leadership-grid">
      <article><span>01</span><h3>Menjaga nilai & budaya</h3><p>Aturan smartphone, disiplin, adab, dan pembinaan tetap ditentukan pesantren. Sistem membantu menjalankan keputusan tersebut dengan konsisten.</p></article>
      <article><span>02</span><h3>Membaca amanah harian</h3><p>Pimpinan melihat tanda yang perlu perhatian: kehadiran, kesehatan, layanan keluarga, dan aktivitas operasional, tanpa perlu menunggu laporan manual.</p></article>
      <article><span>03</span><h3>Menguatkan kepercayaan</h3><p>Orang tua merasakan tata kelola yang tertib dan komunikatif. Reputasi pesantren tumbuh dari layanan yang nyata, bukan janji digital.</p></article>
    </div>
    <p class="leadership-note">Kebijakan tetap diputuskan oleh majelis dan pimpinan. SmartEdu hanya membantu amanah itu terlihat, terlaksana, dan bisa dievaluasi.</p>
  </Slide>

  <Slide id="generous" class="smart-slide">
    <SlideHeader badge="BERTUMBUH BERSAMA" title="Mulai dari yang paling dibutuhkan, lalu perluas dengan tenang." subtitle="Ekosistem yang baik tidak meminta pesantren berubah sekaligus. SmartEdu dapat bertumbuh mengikuti kesiapan budaya, tim, dan infrastruktur sekolah." />
    <div class="module-table">
      <div><strong>Tahap 1</strong><span>Orang tua, kehadiran, izin, dan komunikasi</span></div>
      <div><strong>Tahap 2</strong><span>Kartu NFC, pembayaran, kantin, dan kontrol keluarga</span></div>
      <div><strong>Tahap 3</strong><span>Akademik, halaqah, pembinaan, dan wellbeing</span></div>
      <div><strong>Tahap 4</strong><span>Analitik kepemimpinan dan pengembangan layanan</span></div>
    </div>
    <p class="quiet-note">Setiap tahap tetap memberi manfaat sendiri. Tidak ada fitur yang harus dipakai hanya karena tersedia.</p>
  </Slide>

  <Slide id="trust" bg="light" class="smart-slide">
    <SlideHeader badge="KEPERCAYAAN" title="Teknologi yang menjaga adab, amanah, dan batas." subtitle="Kepercayaan keluarga adalah fondasi. Karena itu setiap fitur perlu memiliki tujuan yang jelas, akses yang terbatas, dan jejak pertanggungjawaban." />
    <div class="trust-grid">
      <article><strong>Data seperlunya</strong><p>Hanya data yang berguna untuk pendidikan, layanan, dan keselamatan yang dikelola.</p></article>
      <article><strong>Akses berdasarkan peran</strong><p>Orang tua, pengasuh, guru, dan pimpinan melihat informasi sesuai amanahnya.</p></article>
      <article><strong>Keputusan tetap manusia</strong><p>Notifikasi dan ringkasan membantu melihat pola; empati serta kebijaksanaan tetap milik tim pesantren.</p></article>
    </div>
  </Slide>

  <Slide id="adoption" class="smart-slide adoption-slide">
    <SlideHeader badge="JALAN ADOPSI" title="Diluncurkan bersama tim, bukan dilempar ke tim." subtitle="Perubahan berjalan baik ketika warga pesantren memahami manfaatnya, mencoba alurnya, dan memiliki ruang untuk menyempurnakannya." />
    <div class="adoption-grid">
      <div><span>01</span><strong>Dengar & petakan</strong><p>Memahami kebiasaan pesantren, kebutuhan keluarga, dan alur kerja tim.</p></div>
      <div><span>02</span><strong>Mulai terbatas</strong><p>Menjalankan satu prioritas dengan pelatihan yang dekat dengan keseharian staf.</p></div>
      <div><span>03</span><strong>Ukur & sempurnakan</strong><p>Mengumpulkan umpan balik lalu menambah modul saat tim sudah siap.</p></div>
    </div>
  </Slide>

  <Slide id="executive-summary" bg="light" class="smart-slide">
    <SlideHeader badge="RINGKASAN UNTUK PIMPINAN" title="Satu ekosistem, tiga hasil yang terasa." subtitle="SmartEdu menyatukan fokus santri, ketenangan keluarga, dan kapasitas tim agar pesantren dapat bertumbuh dengan tetap setia pada adabnya." />
    <div class="summary-grid">
      <div><span>UNTUK SANTRI</span><strong>Lebih hadir dalam belajar, ibadah, dan kehidupan asrama.</strong><p>Kartu NFC menggantikan kebutuhan uang tunai dan smartphone pribadi tetap di luar keseharian pondok.</p></div>
      <div><span>UNTUK KELUARGA</span><strong>Lebih tenang karena kabar dan layanan tersusun rapi.</strong><p>Orang tua menerima ringkasan bermakna, komunikasi terarah, dan kontrol keuangan yang sehat.</p></div>
      <div><span>UNTUK PESANTREN</span><strong>Lebih kuat dalam pembinaan dan tata kelola.</strong><p>Tim menghabiskan lebih sedikit waktu mencari data, lebih banyak waktu hadir untuk santri.</p></div>
    </div>
    <div class="summary-next"><strong>Langkah awal yang realistis</strong><span>Mulai dari komunikasi keluarga, kehadiran, dan izin; lanjutkan ke NFC serta pembinaan sesuai kesiapan pesantren.</span></div>
  </Slide>

  <Slide id="close" bg="dark" class="smart-slide close-slide">
    <div class="close-content">
      <p class="eyebrow">SMARTEDU PESANTREN</p>
      <h1>Ketika sistem bekerja dengan baik,<br />manusia punya lebih banyak waktu untuk membina.</h1>
      <p>Mari bangun pesantren yang tetap teduh, disiplin, dan manusiawi, dengan ekosistem yang siap menemani langkah berikutnya.</p>
      <div><Tag label="Santri Fokus" color="success" /><Tag label="Orang Tua Tenang" color="primary" /><Tag label="Tim Bertumbuh" color="secondary" /></div>
    </div>
  </Slide>

  <Progress current={1} total={19} />
</TrainingLayout>

<style is:global>
  :root { --color-primary: #0c6d55; --color-primary-light: #1d9275; --color-accent: #e7ae45; --color-bg-dark: #10251f; --color-bg-light: #edf4ee; --color-surface: #f6f9f6; --color-text: #16352c; --color-text-muted: #577167; --color-border: #d7e2da; }
