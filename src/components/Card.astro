---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="card">
  <h4 class="card__title">{title}</h4>
  <div class="card__body">
    <slot />
  </div>
</div>

<style>
  .card {
    background: var(--color-surface);
    border-radius: 10px;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    color: var(--color-text, #1a1a2e);
  }
  .card__title {
    margin: 0 0 0.75rem;
    font-size: 1rem;
    font-weight: 700;
  }
  .card__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
</style>
