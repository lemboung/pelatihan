---
interface Props {
  image: string;
  alt: string;
  position?: 'left' | 'right';
  caption?: string;
}

const { image, alt, position = 'right', caption } = Astro.props;
---

<div class={`image-text image-text--${position}`}>
  <div class="image-text__content">
    <slot />
  </div>
  <div class="image-text__media">
    <img src={image} alt={alt} loading="lazy" />
    {caption && <figcaption class="image-text__caption">{caption}</figcaption>}
  </div>
</div>

<style>
  .image-text {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
    flex: 1;
  }
  .image-text--right {
    grid-template-columns: 1fr 1.2fr;
  }
  .image-text--left {
    grid-template-columns: 1.2fr 1fr;
  }
  .image-text--left .image-text__media {
    order: -1;
  }
  .image-text__media img {
    width: 100%;
    height: auto;
    border-radius: 12px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.12);
  }
  .image-text__caption {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    text-align: center;
    margin-top: 0.5rem;
    font-style: italic;
  }
  .image-text__content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (max-width: 768px) {
    .image-text {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .image-text--left .image-text__media {
      order: 0;
    }
  }
</style>
