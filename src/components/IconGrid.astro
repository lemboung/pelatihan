---
interface Props {
  items: { label: string; icon?: string }[];
  columns?: number;
}

const { items, columns = 3 } = Astro.props;
---

<div class="icon-grid" style={`grid-template-columns: repeat(${columns}, 1fr);`}>
  {items.map((item) => (
    <div class="icon-grid__item">
      {item.icon && <span class="icon-grid__icon">{item.icon}</span>}
      <span class="icon-grid__label">{item.label}</span>
    </div>
  ))}
</div>

<style>
  .icon-grid {
    display: grid;
    gap: 1rem;
  }
  .icon-grid__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5rem;
    padding: 1rem;
    border-radius: 10px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }
  .icon-grid__icon {
    font-size: 2rem;
  }
  .icon-grid__label {
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1.3;
  }
</style>
