---
interface Props {
  id?: string;
  class?: string;
  title?: string;
  section?: string;
  bg?: 'default' | 'dark' | 'accent' | 'light';
}

const { id, class: className = '', title, section, bg = 'default' } = Astro.props;
---

<section
  class={`slide slide--${bg} ${className}`}
  data-slide={id}
  data-section={section}
  aria-label={title || 'Slide'}
>
  <div class="slide__inner">
    <slot />
  </div>
</section>

<style>
  .slide {
    display: none;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    position: relative;
  }
  .slide.active {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .slide__inner {
    width: 100%;
    max-width: 1280px;
    height: 100%;
    max-height: 720px;
    margin: 0 auto;
    padding: 3rem 4rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-sizing: border-box;
  }
  .slide--dark {
    background: var(--color-bg-dark);
    color: var(--color-text-light);
  }
  .slide--accent {
    background: var(--color-primary);
    color: #fff;
  }
  .slide--light {
    background: var(--color-bg-light);
  }
  .slide--default {
    background: var(--color-bg);
  }

  @media (max-width: 768px) {
    .slide__inner {
      padding: 2rem 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .slide__inner {
      padding: 1.5rem 1rem;
    }
  }
</style>
