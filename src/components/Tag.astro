---
interface Props {
  label: string;
  icon?: string;
  size?: 'sm' | 'md' | 'lg';
  color?: 'primary' | 'secondary' | 'danger' | 'success';
}

const { label, icon, size = 'md', color = 'primary' } = Astro.props;
---

<span class={`tag tag--${size} tag--${color}`}>
  {icon && <span class="tag__icon">{icon}</span>}
  {label}
</span>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.8rem;
    white-space: nowrap;
  }
  .tag--sm { font-size: 0.7rem; padding: 0.15rem 0.45rem; }
  .tag--lg { font-size: 0.9rem; padding: 0.35rem 0.8rem; }
  .tag--primary { background: #e3f2fd; color: #1565c0; }
  .tag--secondary { background: #f3e5f5; color: #7b1fa2; }
  .tag--danger { background: #fce4ec; color: #c62828; }
  .tag--success { background: #e8f5e9; color: #2e7d32; }
</style>
